---
// Animated Hero with particles and gradient background
---

<section class="hero">
  <div class="hero-background">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
    <div class="gradient-orb orb-3"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-text">
      <h1 class="hero-title">
        Building the Future of
        <span class="gradient-text"> AI-Powered Education</span>
      </h1>
      <p class="hero-subtitle">
        We transform learning experiences through cutting-edge AI technology,
        personalized education platforms, and innovative software solutions.
      </p>
      <div class="hero-cta">
        <a href="/case-studies" class="btn btn-primary">View Our Work</a>
        <a href="#contact" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="floating-card card-1">
        <div class="card-icon">💬</div>
        <div class="card-text">AI Tutoring</div>
      </div>
      <div class="floating-card card-2">
        <div class="card-icon">📖</div>
        <div class="card-text">Language Learning</div>
      </div>
      <div class="floating-card card-3">
        <div class="card-icon">🎯</div>
        <div class="card-text">Personalized Practice</div>
      </div>
      <div class="central-glow"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
    animation: float 20s infinite ease-in-out;
  }

  .orb-1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -100px;
    left: -100px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    background: var(--color-secondary);
    bottom: -50px;
    right: -50px;
    animation-delay: 7s;
  }

  .orb-3 {
    width: 350px;
    height: 350px;
    background: var(--color-accent);
    top: 50%;
    right: 10%;
    animation-delay: 14s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -30px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
    padding: var(--spacing-xl) var(--spacing-md);
  }

  .hero-text {
    color: white;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: var(--spacing-md);
    line-height: 1.1;
    animation: fadeInUp 1s ease-out;
  }

  .gradient-text {
    background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
    background-size: 200% 200%;
  }

  @keyframes gradientShift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #cbd5e1;
    margin-bottom: var(--spacing-md);
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .hero-cta {
    display: flex;
    gap: var(--spacing-sm);
    animation: fadeInUp 1s ease-out 0.4s both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-visual {
    position: relative;
    height: 500px;
    animation: fadeIn 1s ease-out 0.6s both;
  }

  .central-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.3) 0%, transparent 70%);
    border-radius: 50%;
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.2);
      opacity: 0.8;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .floating-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: floatCard 4s ease-in-out infinite;
    transition: transform 0.3s ease;
  }

  .floating-card:hover {
    transform: scale(1.05) !important;
    background: rgba(255, 255, 255, 0.15);
  }

  .card-1 {
    top: 10%;
    left: 10%;
    animation-delay: 0s;
  }

  .card-2 {
    top: 50%;
    right: 10%;
    animation-delay: 1.3s;
  }

  .card-3 {
    bottom: 15%;
    left: 20%;
    animation-delay: 2.6s;
  }

  @keyframes floatCard {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .card-icon {
    font-size: 2.5rem;
  }

  .card-text {
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 968px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      display: none;
    }

    .hero-cta {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero-cta {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
