---
// Social Proof section with achievements and recognition
---

<section class="social-proof">
  <div class="container">
    <div class="section-header">
      <h2>Recognition & Impact</h2>
      <p>Trusted by innovative organizations and recognized for excellence</p>
    </div>

    <div class="achievements-grid">
      <div class="achievement-card">
        <div class="achievement-icon">🏆</div>
        <h3>Schmidt Futures Winner</h3>
        <p>Selected as a winner in the Education Technology Competition sponsored by Schmidt Futures and Ken Griffin</p>
      </div>

      <div class="achievement-card">
        <div class="achievement-icon">🎓</div>
        <h3>Learning Engineering Virtual Institute</h3>
        <p>Participating team in LEVI, advancing the field of learning engineering</p>
      </div>

      <div class="achievement-card">
        <div class="achievement-icon">🌍</div>
        <h3>Global Reach</h3>
        <p>Supporting middle school students in low-resource settings worldwide</p>
      </div>

      <div class="achievement-card">
        <div class="achievement-icon">🚀</div>
        <h3>Innovation Focus</h3>
        <p>Building AI-native applications that push the boundaries of educational technology</p>
      </div>
    </div>

    <div class="stats-section">
      <div class="stat">
        <div class="stat-number" data-target="4">0</div>
        <div class="stat-label">Major Projects</div>
      </div>
      <div class="stat">
        <div class="stat-number" data-target="3">0</div>
        <div class="stat-label">Industries</div>
      </div>
      <div class="stat">
        <div class="stat-number" data-target="100">0</div>
        <div class="stat-label">% AI-Focused</div>
      </div>
    </div>

    <div class="testimonial-section">
      <blockquote class="testimonial">
        <p class="testimonial-text">
          "Legible Labs brings together deep technical expertise with a genuine understanding
          of educational needs, creating solutions that truly make a difference."
        </p>
        <footer class="testimonial-author">
          <strong>Industry Recognition</strong>
          <span>Education Technology Sector</span>
        </footer>
      </blockquote>
    </div>
  </div>
</section>

<script>
  // Animate numbers on scroll
  function animateValue(element: HTMLElement, start: number, end: number, duration: number) {
    let startTimestamp: number | null = null;
    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      element.textContent = Math.floor(progress * (end - start) + start).toString();
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    };
    window.requestAnimationFrame(step);
  }

  // Intersection Observer for scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const statNumbers = entry.target.querySelectorAll('.stat-number');
        statNumbers.forEach((stat) => {
          const target = parseInt((stat as HTMLElement).getAttribute('data-target') || '0');
          animateValue(stat as HTMLElement, 0, target, 2000);
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const statsSection = document.querySelector('.stats-section');
  if (statsSection) {
    observer.observe(statsSection);
  }
</script>

<style>
  .social-proof {
    padding: var(--spacing-xl) 0;
    background: linear-gradient(180deg, white 0%, var(--color-light) 100%);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .section-header h2 {
    color: var(--color-dark);
  }

  .section-header p {
    font-size: 1.25rem;
    color: var(--color-gray);
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .achievement-card {
    background: white;
    padding: var(--spacing-md);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .achievement-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .achievement-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .achievement-card:nth-child(1) .achievement-icon { animation-delay: 0s; }
  .achievement-card:nth-child(2) .achievement-icon { animation-delay: 0.2s; }
  .achievement-card:nth-child(3) .achievement-icon { animation-delay: 0.4s; }
  .achievement-card:nth-child(4) .achievement-icon { animation-delay: 0.6s; }

  .achievement-card h3 {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-xs);
  }

  .achievement-card p {
    color: var(--color-gray);
    font-size: 0.95rem;
    margin: 0;
  }

  .stats-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-lg);
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .stat {
    text-align: center;
    padding: var(--spacing-sm);
  }

  .stat-number {
    font-size: 3.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: var(--spacing-xs);
  }

  .stat-label {
    font-size: 1rem;
    color: var(--color-gray);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .testimonial-section {
    max-width: 800px;
    margin: var(--spacing-xl) auto 0;
  }

  .testimonial {
    background: white;
    padding: var(--spacing-lg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border-left: 4px solid var(--color-primary);
  }

  .testimonial-text {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-dark);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .testimonial-author strong {
    color: var(--color-primary);
    font-size: 1.1rem;
  }

  .testimonial-author span {
    color: var(--color-gray);
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }

    .stats-section {
      grid-template-columns: 1fr;
    }
  }
</style>
