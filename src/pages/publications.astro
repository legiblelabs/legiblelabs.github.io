---
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = [
  {
    title: "AI-Powered Language Learning: From Theory to Practice",
    type: "Case Study",
    date: "2024",
    description: "An in-depth look at how Squidgies uses large language models to provide personalized language learning experiences for intermediate learners.",
    link: "https://squidgies.app",
    tags: ["AI", "Education", "Language Learning", "LLMs"]
  },
  {
    title: "Democratizing Math Education with AI Tutoring",
    type: "Research",
    date: "2023",
    description: "Insights from building Rori, an AI tutor for middle school students in low-resource settings. Winner of the Schmidt Futures Tools Competition.",
    link: "https://rori.ai/",
    tags: ["AI Tutoring", "Education Access", "Mathematics"]
  },
  {
    title: "Spaced Repetition Meets Social Media: A New Approach to Vocabulary Acquisition",
    type: "Technical",
    date: "2022",
    description: "Exploring the intersection of media recommendation algorithms and spaced repetition systems through the legible Twitter client.",
    link: "https://devpost.com/software/legible",
    tags: ["NLP", "EdTech", "Mobile"]
  },
  {
    title: "Using Frequency Analysis for Optimized Language Learning Materials",
    type: "Technical",
    date: "2021",
    description: "How we used natural language processing and frequency statistics to build effective spaced repetition cards for the Refold community.",
    link: "https://refold.la/",
    tags: ["NLP", "Data Engineering", "Language Learning"]
  }
];

const categories = ["All", "Research", "Case Study", "Technical", "Blog"];
---

<BaseLayout
  title="Publications - Legible Labs"
  description="Research, case studies, and insights from our work in AI and education technology">

  <section class="publications-hero">
    <div class="container">
      <h1>Publications & Insights</h1>
      <p class="lead">Research, case studies, and technical deep-dives from our work in AI and education technology</p>
    </div>
  </section>

  <section class="publications-content">
    <div class="container">
      <div class="filter-section">
        <h3>Filter by Category</h3>
        <div class="filter-buttons">
          {categories.map(category => (
            <button class="filter-btn active" data-category={category.toLowerCase()}>
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="publications-grid">
        {publications.map((pub, index) => (
          <article class="publication-card" data-type={pub.type.toLowerCase()} style={`animation-delay: ${index * 0.1}s`}>
            <div class="pub-header">
              <span class="pub-type">{pub.type}</span>
              <span class="pub-date">{pub.date}</span>
            </div>

            <h2 class="pub-title">{pub.title}</h2>
            <p class="pub-description">{pub.description}</p>

            <div class="pub-tags">
              {pub.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <a href={pub.link} target="_blank" rel="noopener noreferrer" class="pub-link">
              Read More →
            </a>
          </article>
        ))}
      </div>

      <div class="empty-state" style="display: none;">
        <div class="empty-icon">📚</div>
        <h3>No publications found</h3>
        <p>Try selecting a different category</p>
      </div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-card">
        <h2>Stay Updated</h2>
        <p>Get notified when we publish new research, case studies, and insights.</p>
        <form class="newsletter-form" id="newsletter-form">
          <input
            type="email"
            placeholder="Enter your email"
            required
            class="email-input"
          />
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        <p class="newsletter-note">We respect your privacy. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const publicationCards = document.querySelectorAll('.publication-card');
  const emptyState = document.querySelector('.empty-state') as HTMLElement;

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active state
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      const category = button.getAttribute('data-category');
      let visibleCount = 0;

      // Filter cards
      publicationCards.forEach(card => {
        const cardType = card.getAttribute('data-type');
        if (category === 'all' || cardType === category) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Show/hide empty state
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
      }
    });
  });

  // Newsletter form
  const newsletterForm = document.getElementById('newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thanks for subscribing! (This is a demo - no actual subscription will be created)');
      (newsletterForm as HTMLFormElement).reset();
    });
  }
</script>

<style>
  .publications-hero {
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    color: white;
    padding: var(--spacing-xl) 0 var(--spacing-lg);
    text-align: center;
  }

  .publications-hero h1 {
    margin-bottom: var(--spacing-sm);
  }

  .lead {
    font-size: 1.5rem;
    color: #cbd5e1;
    max-width: 800px;
    margin: 0 auto;
  }

  .publications-content {
    padding: var(--spacing-xl) 0;
    background: var(--color-light);
  }

  .filter-section {
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }

  .filter-section h3 {
    color: var(--color-dark);
    margin-bottom: var(--spacing-sm);
  }

  .filter-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .filter-btn {
    background: white;
    color: var(--color-gray);
    border: 2px solid var(--color-border);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .publications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--spacing-md);
  }

  .publication-card {
    background: white;
    border-radius: var(--radius);
    padding: var(--spacing-md);
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
    border: 2px solid transparent;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .publication-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
  }

  .pub-type {
    background: var(--color-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .pub-date {
    color: var(--color-gray);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .pub-title {
    color: var(--color-dark);
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
    line-height: 1.3;
  }

  .pub-description {
    color: var(--color-gray);
    line-height: 1.6;
    margin-bottom: var(--spacing-sm);
    flex-grow: 1;
  }

  .pub-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .tag {
    background: var(--color-light);
    color: var(--color-primary);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
  }

  .pub-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
  }

  .pub-link:hover {
    color: var(--color-secondary);
    gap: 0.75rem;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
    text-align: center;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: var(--spacing-sm);
  }

  .empty-state h3 {
    color: var(--color-dark);
    margin-bottom: var(--spacing-xs);
  }

  .empty-state p {
    color: var(--color-gray);
  }

  .newsletter-section {
    padding: var(--spacing-xl) 0;
    background: white;
  }

  .newsletter-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
    padding: var(--spacing-lg);
    border-radius: var(--radius);
  }

  .newsletter-card h2 {
    color: white;
    margin-bottom: var(--spacing-sm);
  }

  .newsletter-card > p {
    font-size: 1.1rem;
    margin-bottom: var(--spacing-md);
    opacity: 0.9;
  }

  .newsletter-form {
    display: flex;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .email-input {
    flex: 1;
    padding: 0.75rem 1.5rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius);
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .email-input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .email-input:focus {
    outline: none;
    border-color: white;
    background: rgba(255, 255, 255, 0.2);
  }

  .newsletter-note {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .publications-grid {
      grid-template-columns: 1fr;
    }

    .newsletter-form {
      flex-direction: column;
    }
  }
</style>
